---
import Base from "../layouts/Base.astro";
import packages from "../data/packages.json";

/* החבילות, המחירים והתנאים יושבים ב-src/data/packages.json - שם מעדכנים.
   כפתור התיאום מעביר לטופס צור קשר עם הנושא וההודעה ממולאים מראש
   (site.js, סעיף 6 קורא את הפרמטרים מהכתובת). */
const contactFor = (p) =>
  "/contact?subject=" + encodeURIComponent("יום הולדת") +
  "&msg=" + encodeURIComponent("מתעניינים בחבילת " + p.title + " (" + p.price + ").");
const contactAny = "/contact?subject=" + encodeURIComponent("יום הולדת");
---

<Base
  title="ימי הולדת בבאולינג שערי חדרה | חבילות לגילאי 5-18"
  description="חבילות ימי הולדת בבאולינג שערי חדרה: גילאי 5-7 מ-70 ₪, גילאי 8-11 מ-75 ₪, נוער 12-18 מ-100 ₪. כולל באולינג, ארוחה, שתייה ועוגה."
  path="/birthdays"
>

<section class="page-head page-head--birthdays">
<div class="wrap">
<p class="eyebrow">מרכז פנאי ובילוי</p>
<h1>ימי הולדת</h1>
<p>שלוש חבילות לפי גיל, מ-70 ₪ לילד</p>
</div>
</section>
<section class="section">
<div class="wrap">
<div class="section-head">
<h2>אופציות לימי הולדת באולינג</h2>
<p class="lead">בואו לחגוג אצלנו את מסיבת יום ההולדת באווירה ייחודית המשלבת משחק באולינג עם שתייה וארוחה מותאמת לגיל החוגג. ניתן לשלב אטרקציות של המשחקייה וקולנוע 7 ממדים.</p>
</div>
<div class="grid grid--3">
{packages.map((p) => (
<article class="package">
<img alt={p.title} loading="lazy" src={p.image} width="300" height="190"/>
<div class="package-body">
<h3>{p.title}</h3>
<p class="price">{p.price}</p>
<ul>{p.items.map((item) => <li>{item}</li>)}</ul>
<p class="fineprint">{p.note}</p>
<a class="btn" href={contactFor(p)}>לתיאום חבילה זו</a>
<a class="package-pdf" href={p.pdf} target="_blank" rel="noopener">דף פרטים נוספים (PDF)</a>
</div>
</article>
))}
</div>
<p style="margin-top: 34px; text-align: center"><a class="btn" href={contactAny}>לתיאום יום הולדת</a></p>
</div>
</section>

</Base>
